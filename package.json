{
  "name": "plitform-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "build:fixture": "node scripts/build-live-fixture.mjs",
    "pretest": "npm run check && npm run build && npm run build:fixture && npm run audit:html && node scripts/audit-html.mjs --live",
    "test": "playwright test",
    "audit:html": "node scripts/audit-html.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": { "astro": "7.4.10" },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.65.0",
    "cheerio": "1.1.2",
    "lighthouse": "13.6.0",
    "node": "22.23.4",
    "typescript": "5.9.3"
  }
}
