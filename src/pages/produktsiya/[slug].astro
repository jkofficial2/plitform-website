---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Icon from '../../components/Icon.astro';
import { products, requestHref, productHref } from '../../data/products';
export function getStaticPaths() { return products.map(product => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
const breadcrumbs = [{ label: 'Продукция', href: '/produktsiya/' }, { label: product.name }];
---
<Layout title={`${product.name} в Ростове-на-Дону — завод «ПлитФорм»`} description={`${product.short} ${product.name} от завода «ПлитФорм» для объектов в Ростове-на-Дону и Ростовской области. Уточните характеристики, цену и сроки.`} breadcrumbs={breadcrumbs}>
  <div class="container"><Breadcrumbs items={breadcrumbs} /><section class="product-hero"><div><span class="eyebrow">ПРОДУКЦИЯ / {product.number}</span><h1>{product.name}</h1><p class="lead">{product.description}</p><a class="button" href={requestHref(product.slug)}>Запросить цену<Icon /></a><p class="hero-hint">Укажите вид плит и количество,<br />чтобы запросить цену и сроки.</p></div><figure class="category-visual"><Image src={product.image} alt={product.alt} widths={[480, 720, 1000, 1400]} sizes="(max-width: 900px) calc(100vw - 40px), 48vw" width={720} height={580} format="webp" loading="eager" fetchpriority="high" /><figcaption class="image-label">Демонстрационное изображение</figcaption></figure></section><section class="product-details section" aria-labelledby="application-heading"><div><span class="eyebrow">ПРИМЕНЕНИЕ</span><h2 id="application-heading">Для каких задач</h2><ul class="application-list">{product.uses.map(use => <li><Icon name="check" /><span>{use}</span></li>)}</ul><p class="small muted">Применение и параметры изделий должны соответствовать проекту объекта.</p></div><div><span class="eyebrow">ПЕРЕД ЗАКАЗОМ</span><h2>Что нужно уточнить</h2><dl class="specifications">{product.specifications.map(spec => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}</dl></div></section><section class="category-request" aria-labelledby="category-request-heading"><div><span class="eyebrow">ДАННЫЕ ДЛЯ РАСЧЁТА</span><h2 id="category-request-heading">Что указать в заявке</h2><ul>{product.request.map(text => <li>{text}</li>)}</ul><p class="small muted">Стоимость, наличие, точные характеристики и документы подтверждает завод. Демонстрационные изображения не заменяют спецификацию.</p></div><div><a class="button" href={requestHref(product.slug)}>Подготовить заявку<Icon /></a><p class="small muted">Категория уже будет выбрана в форме.</p></div></section><nav class="other-products" aria-label="Другие категории продукции"><h2>Другие категории</h2>{products.filter(other => other.slug !== product.slug).map(other => <a href={productHref(other.slug)}>{other.name}<Icon /></a>)}</nav></div>
</Layout>
